# --- Supabase (browser auth; use the anon key or the publishable key) ---
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# Set either VITE_SUPABASE_ANON_KEY or VITE_SUPABASE_PUBLISHABLE_KEY.
# Never put the service-role key in a frontend environment variable.
# VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here
# VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key_here

# --- Backend API (CRITICAL for shared uploads) ---
# IMPORTANT: Both admin_panel and frontend MUST use the SAME backend URL
# to ensure uploads from admin_panel appear on frontend when deployed separately.
# Local development: http://localhost:5000
# Production: https://your-backend-domain.com
VITE_API_BASE_URL=https://your-backend-domain.com
VITE_ASSETS_BASE_URL=https://your-backend-domain.com

# --- Client timetable app ---
VITE_CLIENT_TIMETABLE_URL=https://client-timetable.onrender.com

# --- Public site URL (SEO, Open Graph, Supabase email redirect; no trailing slash) ---
VITE_PUBLIC_SITE_URL=https://www.lyceemuhura.rw
VITE_SITE_URL=https://www.lyceemuhura.rw
