# Copy to .env and fill in real values. Vite only exposes variables prefixed with VITE_.
# Production: set these in your host (e.g. Render) before `npm run build`.

# --- Supabase (browser auth; required for login) ---
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_or_publishable_key_here

# --- Backend API (CRITICAL for shared uploads) ---
# IMPORTANT: Both admin_panel and frontend MUST use the SAME backend URL
# to ensure uploads appear on both sites when deployed separately.
# Local development: http://localhost:5000
# Production: https://your-backend-domain.com
VITE_API_BASE_URL=https://your-backend-domain.com
VITE_ASSETS_BASE_URL=https://

# Smart Management Flask API (meeting workspace and other school operations)
VITE_SMART_MANAGEMENT_API_BASE_URL=https://your-smart-management-domain.com

# --- Timetable app (embedded in admin dashboard) ---
# Example production value:
# VITE_TIMETABLE_APP_URL=https://admi-timetable.onrender.com
VITE_TIMETABLE_APP_URL=https://admi-timetable.onrender.com

# --- Public site URL (no trailing slash) ---
VITE_PUBLIC_SITE_URL=https://admin.lyceemuhura.rw
